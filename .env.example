# 复制为 .env 后按需填写。.env 已被 .gitignore 忽略,不要提交。
# 采集、整理、导出都不需要这些配置;只有使用"AI 分析"时才需要其中一项。

# OpenAI 兼容接口(也可以指向其他兼容服务)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# 本地服务端口,默认 4317
# PORT=4317

# 数据目录(数据库、截图、导出),默认是仓库下的 data/
# UIEV_DATA_DIR=

# 找不到 Chrome/Edge 时,手动指定浏览器可执行文件
# UIEV_CHROME_PATH=

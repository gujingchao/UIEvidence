{
  "name": "uievidence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "网站功能分析与方案生成工具:采集页面证据,整理功能,导出可复核的需求分析",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w @uievidence/server\" \"npm run dev -w @uievidence/web\"",
    "build": "npm run build -w @uievidence/web",
    "start": "npm run build && npm run start -w @uievidence/server",
    "fixtures": "npm run start -w @uievidence/fixtures",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck -w @uievidence/web",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "packages/shared/src",
    "packages/server/src",
    "packages/server/test",
    "packages/fixtures/src",
    "tests",
    "scripts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
